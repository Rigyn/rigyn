{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rigyn:schema:package-gallery:v1",
  "title": "rigyn extension package gallery structural preflight",
  "$comment": "This schema checks portable JSON structure. The rigyn gallery parser is authoritative for UTF-8 byte limits, semantic-version ranges, cross-field equality, canonical URLs and timestamps, and duplicate package IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packages": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,62}$" },
    "url": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^https://(?![^/?#]*@)[^#]+$"
    },
    "semanticVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(sha256|sha384|sha512)-[A-Za-z0-9+/]+={0,2}$"
    },
    "contributionCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "dependencyCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "package", "version", "integrity"],
          "properties": {
            "kind": { "const": "npm" },
            "package": {
              "type": "string",
              "minLength": 1,
              "maxLength": 214,
              "pattern": "^(?:@[a-z0-9][a-z0-9._-]{0,127}/[a-z0-9][a-z0-9._-]{0,127}|[a-z0-9][a-z0-9._-]{0,127})$"
            },
            "version": { "$ref": "#/$defs/semanticVersion" },
            "integrity": { "$ref": "#/$defs/sri" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "revision"],
          "properties": {
            "kind": { "const": "git" },
            "repository": { "$ref": "#/$defs/url" },
            "revision": { "type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" }
          }
        }
      ]
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "tools", "commands", "skills", "prompts", "themes", "providers"],
      "properties": {
        "runtime": { "$ref": "#/$defs/contributionCount" },
        "tools": { "$ref": "#/$defs/contributionCount" },
        "commands": { "$ref": "#/$defs/contributionCount" },
        "skills": { "$ref": "#/$defs/contributionCount" },
        "prompts": { "$ref": "#/$defs/contributionCount" },
        "themes": { "$ref": "#/$defs/contributionCount" },
        "providers": { "$ref": "#/$defs/contributionCount" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": { "enum": ["image", "video"] },
        "url": { "$ref": "#/$defs/url" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "version", "source", "compatibility", "contributions", "readme", "media",
        "publishedAt", "integrity", "provenance", "securityWarnings", "dependencyCount"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "source": { "$ref": "#/$defs/source" },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostVersion"],
          "properties": { "hostVersion": { "type": "string", "minLength": 1, "maxLength": 256 } }
        },
        "contributions": { "$ref": "#/$defs/contributions" },
        "readme": { "$ref": "#/$defs/url" },
        "homepage": { "$ref": "#/$defs/url" },
        "media": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/media" } },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["verified", "declared", "unverified"] },
            "digest": { "$ref": "#/$defs/sri" }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
              "then": { "required": ["digest"] }
            }
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["verified", "publisher-asserted", "unknown"] },
            "detail": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        },
        "securityWarnings": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "dependencyCount": { "$ref": "#/$defs/dependencyCount" }
      }
    }
  }
}
